  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Cognifort Official Website – Daily Brain & Memory Support",
        "meta_descr": "Discover Cognifort, a daily brain support formula designed to support memory, focus, mental clarity, and overall cognitive wellness. Visit the official website.",
        "header_custom": "",
        "footer_custom": "",
